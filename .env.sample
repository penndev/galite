# 模式[开发:dev |生产:prod ] 
APP_MODE="prod"
# http 监听端口
APP_LISTEN=":8000"
APP_SECRET="secret"
APP_LOGGER_FILE="gin.log"
APP_LOGGER_LEVEL="warn"

# 数据库相关配置
DB_URL="mariadb://root:123456@tcp(127.0.0.1:3306)/galite?charset=utf8mb4&parseTime=True&loc=Local"

# 缓存配置
CACHE_URL="redis://default:@127.0.0.1:6379/1"
